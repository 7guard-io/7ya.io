{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/release.json", "destination": "/api/release" },
    { "source": "/", "destination": "/api/site?route=/" },
    { "source": "/7ya/", "destination": "/api/site?route=/7ya/" },
    { "source": "/igor-vepretski/", "destination": "/api/site?route=/igor-vepretski/" },
    { "source": "/journey/", "destination": "/api/site?route=/journey/" },
    { "source": "/work/", "destination": "/api/site?route=/work/" },
    { "source": "/systems/", "destination": "/api/site?route=/systems/" },
    { "source": "/public-service/", "destination": "/api/site?route=/public-service/" },
    { "source": "/music/", "destination": "/api/site?route=/music/" },
    { "source": "/speaker/", "destination": "/api/site?route=/speaker/" },
    { "source": "/pass/", "destination": "/api/site?route=/pass/" },
    { "source": "/radar/", "destination": "/api/site?route=/radar/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/starton/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/evidence/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/talk/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/contact/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/influence/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/social/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/articles/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/public-archive.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
