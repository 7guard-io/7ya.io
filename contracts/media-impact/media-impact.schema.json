{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://7ya.io/schemas/media-impact.schema.json",
  "title": "7YA Media Impact Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "account",
    "scope",
    "post_id",
    "url",
    "title",
    "metric_name",
    "metric_value",
    "metric_display",
    "metric_unit",
    "proof_type",
    "verification_status",
    "collected_at",
    "collected_by",
    "canonical_id",
    "metric_definition_version",
    "owner_access",
    "evidence_chain",
    "public_claim_ok"
  ],
  "properties": {
    "platform": {"type": "string", "minLength": 1},
    "account": {"type": "string", "minLength": 1},
    "scope": {"enum": ["account", "post", "site"]},
    "post_id": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "title": {"type": "string"},
    "metric_name": {"type": "string", "minLength": 1},
    "metric_value": {"type": ["number", "null"]},
    "metric_display": {"type": "string"},
    "metric_unit": {"type": "string"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "proof_screenshot_url": {"type": ["string", "null"], "format": "uri"},
    "proof_type": {"enum": ["public_screenshot", "studio_screenshot", "api_json", "csv_export", "platform_export_json", "manual_capture", "public_profile", "ga4_snapshot"]},
    "verification_status": {"enum": ["unverified", "url_verified", "documented", "metric_verified", "fully_verified", "disputed", "stale"]},
    "notes": {"type": "string"},
    "collected_at": {"type": "string", "format": "date-time"},
    "collected_by": {"type": "string", "minLength": 1},
    "canonical_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "metric_definition_version": {"type": "string", "minLength": 1},
    "source_hash": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "content_fingerprint": {"type": ["string", "null"]},
    "owner_access": {"type": "boolean"},
    "evidence_chain": {"type": "array", "minItems": 1, "items": {"$ref": "https://7ya.io/schemas/evidence-manifest.schema.json"}},
    "public_claim_ok": {"type": "boolean"},
    "root_cause_key": {"type": ["string", "null"]}
  }
}